
erDiagram
    CUSTOMERS ||--o{ CUSTOMER_ORDERS : places
    BRANDS ||--o{ PERFUMES : owns
    CUSTOMER_ORDERS ||--|{ ORDER_ITEMS : contains
    PERFUMES ||--o{ ORDER_ITEMS : included_in
    CUSTOMER_ORDERS ||--o{ PAYMENTS : has

    CUSTOMERS {
        bigint customer_id PK
        varchar full_name
        varchar email UK
        varchar phone
        timestamptz created_at
    }

    BRANDS {
        bigint brand_id PK
        varchar brand_name UK
        varchar country_of_origin
    }

    PERFUMES {
        bigint perfume_id PK
        bigint brand_id FK
        varchar perfume_name
        varchar scent_type
        numeric size_ml
        numeric unit_price
        integer stock_quantity
    }

    CUSTOMER_ORDERS {
        bigint order_id PK
        bigint customer_id FK
        timestamptz order_date
        varchar order_status
    }

    ORDER_ITEMS {
        bigint order_id PK, FK
        bigint perfume_id PK, FK
        integer quantity
        numeric unit_price
    }

    PAYMENTS {
        bigint payment_id PK
        bigint order_id FK
        timestamptz payment_date
        numeric amount
        varchar payment_method
        varchar payment_status
        varchar transaction_reference UK
    }
